<div data-controller="home">
  <header class="header">
    <div class="header-content">
      <h1 class="logo">
        Lie Social
      </h1>
      <nav class="nav">
        <a href="#" class="nav-link active">Home</a>
        <a href="#" class="nav-link">Explore</a>
      </nav>
    </div>
  </header>

  <main class="main-content">
      <h3 class="section-title">Recent Posts</h3>
      <% if @posts.any? %>
      <div class="posts">
          <% @posts.each do |post| %>
            <article class="post" data-controller="post" data-post-id="<%= post.id %>">
              <div class="post__header">
                <div class="post__author-info">
                  <div class="post__avatar">
                    <%= post.user.display_name&.first&.upcase || 'U' %>
                  </div>
                  <div class="post__author-details">
                    <div class="post__author-name"><%= post.user.display_name || post.user.full_name %></div>
                    <div class="post__author-handle">@<%= post.user.email.split('@').first %></div>
                  </div>
                </div>
                <span class="post__date"><%= time_ago_in_words(post.created_at) %> ago</span>
              </div>
              <% if post.title %>
                <h4 class="post__title"><%= post.title %></h4>
              <% end %>
              <p class="post__body"><%= post.body %></p>
              <div class="post__footer">
                <button class="post__action" data-action="click->post#like"><i class="far fa-heart"></i></button>
                <button class="post__action"><i class="far fa-comment"></i></button>
                <button class="post__action"><i class="fas fa-retweet"></i></button>
                <button class="post__action"><i class="fas fa-share"></i></button>
              </div>
            </article>
          <% end %>
        </div>
      <% else %>
        <div class="empty-state">
          <p>No posts yet. Be the first to share!</p>
        </div>
      <% end %>
  </main>
</div>