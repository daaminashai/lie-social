<div class="container" data-controller="home">
  <header class="header">
    <div class="header-content">
      <h1 class="logo">
        <svg class="logo-icon" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm3.5-9c.83 0 1.5-.67 1.5-1.5S16.33 8 15.5 8 14 8.67 14 9.5s.67 1.5 1.5 1.5zm-7 0c.83 0 1.5-.67 1.5-1.5S9.33 8 8.5 8 7 8.67 7 9.5 7.67 11 8.5 11zm3.5 6.5c2.33 0 4.31-1.46 5.11-3.5H6.89c.8 2.04 2.78 3.5 5.11 3.5z"/>
        </svg>
        Lie Social
      </h1>
      <nav class="nav">
        <a href="#" class="nav-link active">Home</a>
        <a href="#" class="nav-link">Explore</a>
        <a href="#" class="nav-link">Messages</a>
      </nav>
    </div>
  </header>

  <main class="main-content">
    <section class="hero">
      <div class="hero-content">
        <h2>Welcome to Lie Social</h2>
        <p>Share your thoughts with the world</p>
        <div class="cta-buttons">
          <button class="btn btn-primary" data-action="showModal@home">Create Post</button>
          <button class="btn btn-secondary">Learn More</button>
        </div>
      </div>
    </section>

    <section class="stats">
      <div class="stat-card">
        <div class="stat-number"><%= @posts_count %></div>
        <div class="stat-label">Posts</div>
      </div>
      <div class="stat-card">
        <div class="stat-number"><%= @users_count %></div>
        <div class="stat-label">Users</div>
      </div>
      <div class="stat-card">
        <div class="stat-number">99%</div>
        <div class="stat-label">Satisfaction</div>
      </div>
    </section>

    <section class="posts-section">
      <h3 class="section-title">Recent Posts</h3>
      <% if @posts.any? %>
        <div class="posts-grid">
          <% @posts.each do |post| %>
            <article class="post-card" data-controller="post" data-post-id="<%= post.id %>">
              <div class="post-header">
                <h4 class="post-title"><%= post.title %></h4>
                <span class="post-date"><%= time_ago_in_words(post.created_at) %> ago</span>
              </div>
              <p class="post-body"><%= truncate(post.body, length: 150) %></p>
              <div class="post-footer">
                <span class="post-author">by <%= post.user.full_name %></span>
                <button class="post-action" data-action="click->post#like">❤️ Like</button>
              </div>
            </article>
          <% end %>
        </div>
      <% else %>
        <div class="empty-state">
          <p>No posts yet. Be the first to share!</p>
        </div>
      <% end %>
    </section>

    <section class="features">
      <h3 class="section-title">Why Choose Lie Social?</h3>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">🚀</div>
          <h4>Lightning Fast</h4>
          <p>Built with Rails and Stimulus for performance</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🔒</div>
          <h4>Secure</h4>
          <p>Your data is protected with industry standards</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">📱</div>
          <h4>Mobile Ready</h4>
          <p>Works seamlessly on all devices</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <p>&copy; 2026 Lie Social. All rights reserved.</p>
    <div class="footer-links">
      <a href="#">Privacy</a>
      <a href="#">Terms</a>
      <a href="#">Contact</a>
    </div>
  </footer>
</div>

<div id="modal" class="modal hidden" data-controller="modal">
  <div class="modal-overlay" data-action="click->modal#close"></div>
  <div class="modal-content">
    <button class="modal-close" data-action="click->modal#close">✕</button>
    <h3>Create a New Post</h3>
    <form>
      <input type="text" placeholder="Post title" required>
      <textarea placeholder="What's on your mind?" rows="6" required></textarea>
      <div class="modal-actions">
        <button type="button" class="btn btn-secondary" data-action="click->modal#close">Cancel</button>
        <button type="submit" class="btn btn-primary">Post</button>
      </div>
    </form>
  </div>
</div>
